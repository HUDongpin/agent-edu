{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicourse.top/courses/agentic-video-editing/artifact-submission.schema.json",
  "title": "Course 20 artifact submission v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "projectSpecId",
    "projectId",
    "path",
    "moduleSlug",
    "revision",
    "contentText",
    "contentSha256",
    "semanticSha256",
    "dependencyArtifactHashes",
    "validatorVersion",
    "validationReceipt",
    "receipt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aicourse.course20.artifact-submission.v2"
    },
    "artifactId": {
      "$ref": "#/$defs/artifactId"
    },
    "projectSpecId": {
      "const": "course20-verified-cut-v2"
    },
    "projectId": {
      "type": "string",
      "minLength": 3
    },
    "path": {
      "enum": ["core", "builder-extension"]
    },
    "moduleSlug": {
      "enum": [
        "agentic-editing-contract",
        "media-ingest-provenance",
        "transcripts-shots-index",
        "semantic-analysis-director",
        "declarative-edit-plan",
        "captions-audio-formats",
        "agent-tools-mcp",
        "deterministic-rendering",
        "verification-human-review",
        "production-capstone"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "contentText": {
      "type": "string"
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256OrEmpty"
    },
    "semanticSha256": {
      "$ref": "#/$defs/sha256OrEmpty"
    },
    "dependencyArtifactHashes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/artifactId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "validatorVersion": {
      "type": "string",
      "minLength": 3
    },
    "validationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": {
          "enum": ["draft", "valid", "blocked", "stale"]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "contentSha256",
        "validatorId",
        "validatorVersion",
        "status",
        "issues"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256OrEmpty"
        },
        "validatorId": {
          "type": "string",
          "minLength": 3
        },
        "validatorVersion": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "enum": ["valid", "blocked"]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reviewDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "boundArtifactSha256",
        "reviewerRole"
      ],
      "properties": {
        "decision": {
          "enum": ["approved", "blocked", "not-required"]
        },
        "boundArtifactSha256": {
          "$ref": "#/$defs/sha256OrEmpty"
        },
        "reviewerRole": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  },
  "$defs": {
    "artifactId": {
      "enum": [
        "creative-brief-responsibility-map",
        "media-manifest-provenance-quarantine",
        "evidence-index-transcript-shots",
        "candidate-segments-system-card",
        "edit-plan-v3-validation-approval",
        "plan-diff-independent-approval",
        "delivery-matrix-accessibility",
        "tool-policy-adversarial-recovery",
        "render-receipt-output-probe",
        "candidate-media-reference",
        "verification-repair-approval",
        "release-package-runbook-recovery",
        "release-decision-postmortem"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256OrEmpty": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{64})?$"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 3 },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 3 }
      }
    }
  }
}
