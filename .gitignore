# ---------------------------------------------------------------------------
# Secrets. This repo is public. Nothing in this block may ever be committed.
# (create-next-app overwrote this file once already — if you re-scaffold,
#  check this block survived before you run `git add`.)
# ---------------------------------------------------------------------------
*.docx
*.doc
.~*
.env
.env.*
*.pem
*.key
*secret*
!scripts/check-secrets.mjs
*credential*
*API*Key*

# Legacy recorded model replies may contain prompts; never commit them.
course/cafe/fixtures.*.json
course/progress.json
legacy/course-python/cafe/fixtures.*.json

# ---------------------------------------------------------------------------
# Build output and dependencies
# ---------------------------------------------------------------------------
/node_modules
/.next/
/out/
/build
/coverage
/playwright-report/
/test-results/
/blob-report/
/browser-evidence/
/.playwright-raw/
/.playwright-private/
/.playwright-evidence-contract-safe/
/.playwright-evidence-contract-private/
next-env.d.ts
*.tsbuildinfo
.vercel
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python virtualenvs, anywhere in the tree
.venv/
venv/
__pycache__/
*.pyc

# Local dev tooling
.claude/

# Private working notes. Untracked is not enough: `git add -A` would stage
# these into a public repo.
2026*_claude suggestions*.md

# Generated review aids: bulk source text, regenerated per candidate by
# `npm run review:packet`. docs/release/evidence/ holds sanitized conclusions,
# not 250KB of strings per locale.
review-packets/

# Local scratch, captures and review bundles. Until now these were hidden only
# by this machine's .git/info/exclude, which no clone, worktree or other
# session shares, so a `git add -A` anywhere else would stage gigabytes into a
# public repo. Anchored to the root, unlike the copies in .vercelignore, so a
# future examples/ or notes/ inside course/ is not silently ignored.
/tmp/
/examples/
/output/
/outputs/
/notes/
/video-pilot/
/course_review_*/
/.playwright-cli/

# Junk
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
