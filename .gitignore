# ---------------------------------------------------------------------------
# Secrets. This repo is public. Nothing in this block may ever be committed.
# (create-next-app overwrote this file once already — if you re-scaffold,
#  check this block survived before you run `git add`.)
# ---------------------------------------------------------------------------
*.docx
*.doc
.~*
.env
.env.*
*.pem
*.key
*secret*
!scripts/check-secrets.mjs
*credential*
*API*Key*

# Recorded model replies (may contain your prompts; regenerate locally)
course/cafe/fixtures.*.json
course/progress.json
legacy/course-python/cafe/fixtures.*.json

# ---------------------------------------------------------------------------
# Build output and dependencies
# ---------------------------------------------------------------------------
/node_modules
/.next/
/out/
/build
/coverage
/playwright-report/
/test-results/
/blob-report/
next-env.d.ts
*.tsbuildinfo
.vercel
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python virtualenvs, anywhere in the tree
.venv/
venv/
__pycache__/
*.pyc

# Local dev tooling
.claude/

# Private working notes. Untracked is not enough: `git add -A` would stage
# these into a public repo.
2026*_claude suggestions*.md

# Junk
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
