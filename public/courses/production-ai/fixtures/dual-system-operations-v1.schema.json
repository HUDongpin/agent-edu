{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-learning.ai/courses/production-ai/fixtures/dual-system-operations-v1.schema.json",
  "title": "Course 21 original dual-system operations fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "createdOn", "origin", "seed", "systems", "documents", "operations", "goldAssertions", "claimBoundary"],
  "properties": {
    "schemaVersion": {"const": "production-ai.fixture.v1"},
    "fixtureId": {"const": "ae-production-ai-dual-system-v1"},
    "createdOn": {"const": "2026-08-26"},
    "origin": {"type": "string", "minLength": 30},
    "seed": {"const": 20260826},
    "systems": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["systemId", "kind", "serviceVersion", "modelVersion", "rollbackTarget", "qualityContract"],
        "properties": {
          "systemId": {"enum": ["fictional-classifier", "fictional-rag"]},
          "kind": {"enum": ["classifier", "retrieval-generation"]},
          "serviceVersion": {"type": "string", "minLength": 3},
          "modelVersion": {"type": "string", "minLength": 3},
          "indexVersion": {"type": "string", "minLength": 3},
          "rollbackTarget": {"type": "string", "minLength": 3},
          "qualityContract": {"type": "string", "minLength": 20}
        },
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "version", "status", "text"],
        "properties": {
          "documentId": {"type": "string", "pattern": "^doc-[a-z-]+$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["approved", "quarantined"]},
          "text": {"type": "string", "minLength": 10}
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "systemId", "cohort", "state", "status", "latencyMs", "costUnits", "output", "criticalFailure", "traceComplete"],
        "properties": {
          "operationId": {"type": "string", "pattern": "^op-[0-9]{3}$"},
          "systemId": {"enum": ["fictional-classifier", "fictional-rag"]},
          "cohort": {"type": "string", "minLength": 3},
          "state": {"enum": ["shadow", "canary", "hold", "rollback", "released"]},
          "status": {"enum": ["success", "timeout-after-commit", "duplicate-suppressed", "redaction-blocked"]},
          "latencyMs": {"type": "integer", "minimum": 0},
          "costUnits": {"type": "integer", "minimum": 0},
          "output": {"type": "string"},
          "gold": {"type": "string"},
          "citations": {"type": "array", "items": {"type": "string", "pattern": "^doc-[a-z-]+$"}},
          "supported": {"type": "boolean"},
          "criticalFailure": {"type": "boolean"},
          "traceComplete": {"type": "boolean"}
        }
      }
    },
    "goldAssertions": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 20}},
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "prohibited"],
      "properties": {
        "allowed": {"type": "string", "minLength": 40},
        "prohibited": {"type": "string", "minLength": 40}
      }
    }
  }
}
