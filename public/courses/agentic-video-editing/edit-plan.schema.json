{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicourse.top/schemas/agentic-video-editing/edit-plan.v2.schema.json",
  "title": "Course 20 auditable edit plan",
  "description": "An original teaching schema for a reviewable, frame-addressed, non-destructive video-editing plan. It validates plan-local structure only; approval and release are separate hash-bound human records.",
  "$comment": "A conforming executor must also run semantic checks that JSON Schema cannot express: operationId uniqueness by field, sourceMediaId resolution, positive and in-bounds frame ranges, timeline arithmetic, target tolerance, realpath and symlink containment, actual hash matching, evidence resolution, rights validity, and human meaning/QC review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "planMode",
    "status",
    "inputs",
    "timeline",
    "executionPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aicourse.agentic-video-editing.edit-plan.v2"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{7,79}$"
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{7,79}$"
    },
    "planMode": {
      "enum": [
        "production",
        "teaching-fixture"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready-for-human-review",
        "blocked"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/productionInput"
          },
          {
            "$ref": "#/$defs/teachingInput"
          }
        ]
      }
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    },
    "executionPolicy": {
      "$ref": "#/$defs/executionPolicy"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "planMode": {
            "const": "teaching-fixture"
          }
        },
        "required": [
          "planMode"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "fixtureId"
        ],
        "properties": {
          "fixtureId": {
            "const": "course20-cut-plan-lab-v2"
          },
          "status": {
            "const": "blocked"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/teachingInput"
            }
          }
        }
      },
      "else": {
        "type": "object",
        "not": {
          "required": [
            "fixtureId"
          ]
        },
        "properties": {
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/productionInput"
            }
          },
          "timeline": {
            "type": "object",
            "properties": {
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rightsState": {
                      "const": "approved-for-declared-use"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mediaId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "productionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputKind",
        "mediaId",
        "expectedSha256",
        "manifestDecision",
        "rightsDecision",
        "probeReceiptSha256",
        "expectedDurationFrames"
      ],
      "properties": {
        "inputKind": {
          "const": "source-media"
        },
        "mediaId": {
          "$ref": "#/$defs/mediaId"
        },
        "expectedSha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifestDecision": {
          "const": "eligible-for-editing"
        },
        "rightsDecision": {
          "const": "approved-for-declared-use"
        },
        "probeReceiptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "expectedDurationFrames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "teachingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputKind",
        "mediaId",
        "expectedSha256",
        "manifestDecision",
        "rightsDecision",
        "probeReceiptSha256",
        "expectedDurationFrames"
      ],
      "properties": {
        "inputKind": {
          "const": "synthetic-text-fixture"
        },
        "mediaId": {
          "$ref": "#/$defs/mediaId"
        },
        "expectedSha256": {
          "type": "null"
        },
        "manifestDecision": {
          "const": "fixture-only-no-source-media"
        },
        "rightsDecision": {
          "const": "not-applicable-no-source-media"
        },
        "probeReceiptSha256": {
          "type": "null"
        },
        "expectedDurationFrames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startInclusive",
        "durationFrames"
      ],
      "properties": {
        "startInclusive": {
          "type": "integer",
          "minimum": 0
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifactId",
        "artifactSha256",
        "locator",
        "evidenceMode"
      ],
      "properties": {
        "kind": {
          "enum": [
            "brief-requirement",
            "transcript-span",
            "shot-boundary",
            "visual-observation",
            "human-note"
          ]
        },
        "artifactId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "artifactSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "evidenceMode": {
          "enum": [
            "source-record",
            "teaching-fixture"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidenceMode": {
                "const": "source-record"
              }
            },
            "required": [
              "evidenceMode"
            ]
          },
          "then": {
            "properties": {
              "artifactSha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "else": {
            "properties": {
              "artifactSha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "kind",
        "trackId",
        "sourceMediaId",
        "sourceFrames",
        "timelineStartFrame",
        "reason",
        "evidence",
        "confidence",
        "ambiguity",
        "rightsState",
        "requiresHumanReview"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^op-[a-z0-9][a-z0-9-]{5,63}$"
        },
        "kind": {
          "enum": [
            "select",
            "insert",
            "ripple-cut",
            "trim-head",
            "trim-tail",
            "split",
            "replace-audio",
            "add-caption",
            "add-title-card"
          ]
        },
        "trackId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "sourceMediaId": {
          "$ref": "#/$defs/mediaId"
        },
        "sourceFrames": {
          "$ref": "#/$defs/frameRange"
        },
        "timelineStartFrame": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguity": {
          "enum": [
            "none-declared",
            "timing",
            "speaker-attribution",
            "meaning",
            "rights",
            "privacy",
            "creative-intent"
          ]
        },
        "rightsState": {
          "enum": [
            "approved-for-declared-use",
            "simulated-cleared",
            "unknown"
          ]
        },
        "requiresHumanReview": {
          "const": true
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timebase",
        "operations",
        "targetDurationFrames",
        "durationToleranceFrames",
        "expectedDurationFrames"
      ],
      "properties": {
        "timebase": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "framesPerSecondNumerator",
            "framesPerSecondDenominator"
          ],
          "properties": {
            "framesPerSecondNumerator": {
              "type": "integer",
              "minimum": 1
            },
            "framesPerSecondDenominator": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "targetDurationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "durationToleranceFrames": {
          "type": "integer",
          "minimum": 0
        },
        "expectedDurationFrames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dryRunRequired",
        "overwriteOriginals",
        "allowNetwork",
        "allowPublish",
        "outputDirectory",
        "stopOnInputHashMismatch",
        "stopOnUnresolvedAmbiguity"
      ],
      "properties": {
        "dryRunRequired": {
          "const": true
        },
        "overwriteOriginals": {
          "const": false
        },
        "allowNetwork": {
          "const": false
        },
        "allowPublish": {
          "const": false
        },
        "outputDirectory": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "pattern": "^edits/(?:[a-z0-9][a-z0-9-]{0,63}/){1,6}$"
        },
        "stopOnInputHashMismatch": {
          "const": true
        },
        "stopOnUnresolvedAmbiguity": {
          "const": true
        }
      }
    }
  }
}
