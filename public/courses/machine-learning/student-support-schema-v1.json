{
  "profile": "tabular-data-package",
  "name": "student-support-synthetic-v1",
  "title": "Fictional student-support modeling fixture",
  "description": "A fixed, fully synthetic table created for Course 19. It contains no real learner, institution, intervention, or outcome records and cannot authorize deployment.",
  "fixture_version": "machine-learning-fixture.v1",
  "primaryKey": ["record_id"],
  "fields": [
    { "name": "record_id", "type": "string", "constraints": { "required": true, "unique": true, "pattern": "^M[0-9]{3}$" } },
    { "name": "learner_code", "type": "string", "constraints": { "required": true, "unique": true, "pattern": "^P[0-9]{3}$" } },
    { "name": "partition", "type": "string", "constraints": { "required": true, "enum": ["train", "validation", "holdout"] } },
    { "name": "cohort", "type": "string", "constraints": { "required": true, "enum": ["jade", "lilac", "sand"] } },
    { "name": "prior_score", "type": "number", "constraints": { "required": true, "minimum": 0, "maximum": 1 } },
    { "name": "study_minutes", "type": "integer", "constraints": { "required": true, "minimum": 0, "maximum": 240 } },
    { "name": "practice_attempts", "type": "integer", "constraints": { "required": true, "minimum": 0, "maximum": 12 } },
    { "name": "late_submissions", "type": "integer", "constraints": { "required": true, "minimum": 0, "maximum": 8 } },
    { "name": "support_requested", "type": "string", "constraints": { "required": true, "enum": ["yes", "no"] } },
    { "name": "completion_next_period", "type": "integer", "constraints": { "required": true, "enum": [0, 1] } }
  ]
}
