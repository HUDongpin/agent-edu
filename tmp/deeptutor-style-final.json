    {
      "para_index": 1,
      "text": "\u8bc1\u636e\u578b\u4ea7\u54c1\u7814\u7a76\u7b80\u62a5",
      "style": "Normal"
    },
    {
      "para_index": 2,
      "text": "DeepTutor \u5bf9\u672c\u9879\u76ee\u7684\n\u542f\u53d1\u4e0e\u843d\u5730\u8def\u7ebf\u56fe",
      "style": "Normal"
    },
    {
      "para_index": 4,
      "text": "aicourse.top / Agentic Engineering \u9879\u76ee",
      "style": "Normal"
    },
    {
      "para_index": 6,
      "text": "\u751f\u4ea7\u90e8\u7f72\u72b6\u6001\uff1aNOT_ASSESSABLE  \u00b7  \u672c\u62a5\u544a\u53ea\u6838\u9a8c\u5f53\u524d\u5de5\u4f5c\u6811",
      "style": "Normal"
    },
    {
      "para_index": 8,
      "text": "\u5efa\u8bae\u8def\u7ebf\uff1a\u4fdd\u7559\u9759\u6001\u8bfe\u7a0b\u4e3a\u6743\u5a01\u53d1\u5e03\u9762\uff0c\u589e\u52a0\u72ec\u7acb\u3001\u53ef\u9009\u3001\u53ef\u64a4\u9500\u7684 Tutor \u670d\u52a1\u9762",
      "style": "Normal"
    },
    {
      "para_index": 11,
      "text": "\u5224\u65ad  \u6267\u884c\u6458\u8981\u3001\u8303\u56f4\u4e0e\u8bc1\u636e\u8fb9\u754c",
      "style": "Normal"
    },
    {
      "para_index": 12,
      "text": "\u5bf9\u7167  \u672c\u9879\u76ee\u57fa\u7ebf\u3001DeepTutor \u67b6\u6784\u4e0e\u8bc1\u636e\u5f3a\u5ea6",
      "style": "Normal"
    },
    {
      "para_index": 13,
      "text": "\u8bbe\u8ba1  \u8bfe\u7a0b\u5185\u5bb9\u3001AI Tutor\u3001RAG\u3001Memory \u4e0e\u5176\u4ed6\u5de5\u7a0b\u542f\u53d1",
      "style": "Normal"
    },
    {
      "para_index": 14,
      "text": "\u843d\u5730  \u53cc\u5e73\u9762\u76ee\u6807\u67b6\u6784\u3001\u8def\u7ebf\u56fe\u4e0e P0/P1/P2 \u4f18\u5148\u7ea7",
      "style": "Normal"
    },
    {
      "para_index": 15,
      "text": "\u9a8c\u8bc1  \u6210\u529f\u6307\u6807\u3001\u771f\u5b9e\u5b66\u4e60\u5b9e\u9a8c\u4e0e\u98ce\u9669\u6e05\u5355",
      "style": "Normal"
    },
    {
      "para_index": 16,
      "text": "\u8bc1\u636e  \u56fa\u5b9a\u7248\u672c\u6765\u6e90\u3001\u672c\u5730\u5b9a\u4f4d\u4e0e\u590d\u6838\u8bf4\u660e",
      "style": "Normal"
    },
    {
      "para_index": 17,
      "text": "\u9605\u8bfb\u63d0\u793a  \u201c\u5df2\u6838\u5b9e\u4e8b\u5b9e\u201d\u201c\u5408\u7406\u63a8\u65ad\u201d\u201c\u672c\u9879\u76ee\u5efa\u8bae\u201d\u5728\u62a5\u544a\u4e2d\u4fdd\u6301\u5206\u79bb\uff1b\u5f53\u524d\u5de5\u4f5c\u6811\u4e0d\u7b49\u4e8e\u751f\u4ea7\u4e0a\u7ebf\uff0c\u8bba\u6587\u4ee3\u7406\u6307\u6807\u4e5f\u4e0d\u7b49\u4e8e\u771f\u5b9e\u5b66\u4e60\u589e\u76ca\u3002",
      "style": "Normal"
    },
    {
      "para_index": 30,
      "text": "\u5df2\u6838\u5b9e\u4e8b\u5b9e\uff1a\u53ef\u7531\u56fa\u5b9a\u63d0\u4ea4\u7684\u6e90\u7801\u3001README\u3001\u53d1\u5e03\u9875\u6216\u8bba\u6587\u76f4\u63a5\u652f\u6301\u3002",
      "style": "List Body Exact"
    },
    {
      "para_index": 31,
      "text": "\u5408\u7406\u63a8\u65ad\uff1a\u7531\u591a\u4e2a\u4e8b\u5b9e\u7ec4\u5408\u800c\u6210\uff0c\u4f46\u4e0d\u662f\u539f\u4f5c\u8005\u76f4\u63a5\u58f0\u79f0\u7684\u7ed3\u679c\u3002",
      "style": "List Body Exact"
    },
    {
      "para_index": 32,
      "text": "\u672c\u9879\u76ee\u5efa\u8bae\uff1a\u9488\u5bf9 aicourse.top \u7684\u8bbe\u8ba1\u9009\u62e9\uff1b\u4e0d\u662f DeepTutor \u5df2\u9a8c\u8bc1\u7684\u7ed3\u8bba\u3002",
      "style": "List Body Exact"
    },
    {
      "para_index": 40,
      "text": "\u53d1\u5e03\u53ef\u9760\uff1aNext.js \u9759\u6001\u5bfc\u51fa\uff0c\u4e0d\u4f9d\u8d56\u751f\u4ea7\u6570\u636e\u5e93\u6216\u5e38\u9a7b\u5e94\u7528\u670d\u52a1\u5668\uff1b\u8bfe\u7a0b\u53ef\u4ee5\u88ab\u7f13\u5b58\u548c\u957f\u671f\u5f15\u7528\u3002[L1][L2]",
      "style": "List Body Exact"
    },
    {
      "para_index": 41,
      "text": "\u9690\u79c1\u9ed8\u8ba4\u8f83\u5f3a\uff1a\u5b66\u4e60\u8fdb\u5ea6\u53ea\u5b58\u5728\u6d4f\u89c8\u5668 localStorage\uff1b\u901a\u7528\u8bfe\u7a0b\u65e0\u9700\u8d26\u6237\u3002[L3]",
      "style": "List Body Exact"
    },
    {
      "para_index": 42,
      "text": "\u8bc1\u636e\u610f\u8bc6\u6210\u719f\uff1aRAG \u8bfe\u7a0b\u5bf9\u6765\u6e90\u3001\u8bb8\u53ef\u3001\u5a92\u4f53\u6765\u6e90\u3001\u68c0\u67e5\u548c fail-closed \u884c\u4e3a\u6709\u660e\u786e\u7ed3\u6784\u3002[L5]",
      "style": "List Body Exact"
    },
    {
      "para_index": 80,
      "text": "\u89e3\u91ca Explain\uff1a\u5148\u8bc6\u522b\u76ee\u6807\u6982\u5ff5\u548c\u5df2\u6709\u8bc1\u636e\uff0c\u518d\u7ed9\u5206\u5c42\u89e3\u91ca\uff1b\u6240\u6709\u53ef\u6838\u5b9e\u77e5\u8bc6\u4e3b\u5f20\u663e\u793a\u8bfe\u7a0b\u51fa\u5904\uff1b\u8bc1\u636e\u4e0d\u8db3\u65f6\u660e\u786e\u62d2\u7b54\u6216\u8bf7\u6c42\u8865\u5145\u3002",
      "style": "List Body Exact"
    },
    {
      "para_index": 81,
      "text": "\u5f15\u5bfc Coach\uff1a\u5148\u8bca\u65ad\u5361\u70b9\uff0c\u518d\u6309\u63d0\u793a\u9636\u68af\u63a8\u8fdb\uff08\u6f84\u6e05\u95ee\u9898\u2192\u8f7b\u63d0\u793a\u2192\u5f3a\u63d0\u793a\u2192\u5c40\u90e8\u793a\u4f8b\u2192\u5b8c\u6574\u89e3\u6cd5\uff09\uff1b\u9ed8\u8ba4\u4e0d\u76f4\u63a5\u6cc4\u9732\u5b8c\u6574\u7b54\u6848\u3002",
      "style": "List Body Exact"
    }
  ],
